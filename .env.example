# ═══════════════════════════════════════════════════════════════════════════════
# Family Office Intelligence Pipeline — Environment Configuration
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your keys. All features work without
# API keys, but enrichment depth is limited without SERPER_API_KEY.
#
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════════════════════

# ── API Keys ─────────────────────────────────────────────────────────────────

# Serper.dev API key for Google search enrichment (free tier: 2500 q/month)
# Get yours at https://serper.dev
SERPER_API_KEY=

# OpenAI API key (optional — for enhanced LLM-based reply generation)
OPENAI_API_KEY=

# ── Data Paths ───────────────────────────────────────────────────────────────

# Directory for seed/enriched JSON data (default: data/)
FO_DATA_DIR=

# ChromaDB persistence directory (default: data/chromadb)
CHROMA_PERSIST_DIR=

# ── Pipeline Control ─────────────────────────────────────────────────────────

# Number of entities to process between pauses (default: 10)
PIPELINE_BATCH_SIZE=10

# Delay in seconds between website requests (default: 1.5)
# Increase this to be polite to target servers
REQUEST_DELAY_SEC=1.5

# Max retries for failed HTTP requests (default: 3)
MAX_RETRIES=3

# SEC EDGAR requests per second limit (default: 10 — SEC's fair-access limit)
SEC_RATE_LIMIT_PER_SEC=10.0

# ── Feature Flags ────────────────────────────────────────────────────────────

# Enrich using SEC EDGAR (CIK lookup, Form ADV AUM extraction)
ENABLE_SEC_ENRICHMENT=true

# Enrich using web search (Serper.dev) and website scraping
ENABLE_WEB_ENRICHMENT=true

# ── Micro-RAG ────────────────────────────────────────────────────────────────

# Embedding model for ChromaDB (default: all-MiniLM-L6-v2 via sentence-transformers)
EMBEDDING_MODEL=all-MiniLM-L6-v2

# ── Streamlit UI ─────────────────────────────────────────────────────────────

# FastAPI backend URL that the Streamlit UI connects to
FO_API_BASE=http://localhost:8000
